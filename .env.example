# --- Cloud live mode (public, safe to expose) ---
# The Supabase project that holds the rooms (supabase/migrations/0003_live_rooms.sql).
# Leave empty and the site runs as demo + local Agent Lounge only.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# A personal site: 1 sends a visitor without a key or a team invite to the project instead of handing out a café.
# Close the database to new cafés too (0022_private_cafe.sql): select public.relay_private(true);
NEXT_PUBLIC_RELAY_PRIVATE=
# Web push for "Claude waits on you" (npx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=https://your-site.example
